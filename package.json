  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.151.3",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "vitest": "^4.1.0"
  }
}
