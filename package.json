{
  "name": "solidjs-workers-hello",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
