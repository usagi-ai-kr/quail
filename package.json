{
  "name": "solidjs-workers-hello",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "test": "pnpm test:workers && pnpm test:ui",
    "test:workers": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "deploy:verify": "node scripts/deploy-verify.mjs"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "hono": "^4.13.13",
    "ky": "^2.2.0",
    "paseto-ts": "^2.0.7",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.3"
  }
}
